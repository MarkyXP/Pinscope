# Pinscope Backend — Environment Variables
# Copy to .env and fill in values. See README.md for LLM setup.

# -- AI (LiteLLM) ------------------------------------------------------------
# Your API key for the chosen provider.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GOOGLE_API_KEY=...

# Default model in LiteLLM format (e.g. "openai/gpt-4o", "ollama/llama3.1:70b").
# Per-stage overrides fall back to this value.
DEFAULT_MODEL=anthropic/claude-sonnet-4-6

# Per-stage model overrides (LiteLLM format — leave empty to use DEFAULT_MODEL).
MODEL_PINTABLE=
MODEL_PATTERN=
MODEL_SPECS=
MODEL_VALIDATION=
MODEL_AUTO_RESOLVE=
MODEL_NORMALIZE=

# Per-stage fallback model — used if the primary stage call raises.
# Leave empty to disable fallback for that stage. If set but empty,
# the fallback uses DEFAULT_MODEL.
# FALLBACK_MODEL_VALIDATION=anthropic/claude-haiku-4-5-20251001

# Custom base URL — for local servers (Ollama, llamafile) or API gateways.
# Only needed for Ollama (default: http://localhost:11434) and llamafile.
# OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_BASE_URL=http://localhost:8080/v1

# -- Storage -----------------------------------------------------------------
# Set GCS_BUCKET to store projects/library in Google Cloud Storage.
# Leave empty for local mode (uses the data/ directory).
GCS_BUCKET=

# -- CORS --------------------------------------------------------------------
# Frontend URL(s), JSON list
CORS_ORIGINS=["http://localhost:3000"]

# -- DigiKey (optional) ------------------------------------------------------
# Enables datasheet auto-fetch and parameter-based passive auto-resolve.
# DIGIKEY_CLIENT_ID=
# DIGIKEY_CLIENT_SECRET=
# DIGIKEY_ENVIRONMENT=production
# DIGIKEY_LOCALE_SITE=US
# DIGIKEY_LOCALE_LANGUAGE=en
# DIGIKEY_LOCALE_CURRENCY=USD

# -- Email notifications (optional) ------------------------------------------
# Gmail API via domain-wide delegation. Leave EMAIL_SENDER empty to disable.
# Service account credentials come from GOOGLE_APPLICATION_CREDENTIALS.
EMAIL_SENDER=
EMAIL_FRONTEND_URL=
# Fixed admin email for pipeline-started notifications (leave empty to disable)
EMAIL_ADMIN_NOTIFY=
# Recipient for /api/contact form submissions (leave empty to disable)
CONTACT_RECIPIENT=
